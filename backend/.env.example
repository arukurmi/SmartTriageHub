# Backend environment variables. Copy to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# HTTP port the server listens on.
PORT=5000

# Comma-separated list of browser origins allowed to call the API (CORS).
# Requests with no Origin header (server-to-server, curl, health checks) are
# always permitted. Defaults to http://localhost:3000 if unset.
ALLOWED_ORIGINS=http://localhost:3000

# Supabase project URL and keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key — full access, keep server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key used by the RAG / ingestion services.
GEMINI_API_KEY=

# GitHub personal access token used for polling issues / merged PRs.
GITHUB_TOKEN=

# Shared secret configured on the GitHub webhook; used to verify the HMAC
# signature on incoming deliveries. The webhook route fails closed if unset.
GITHUB_WEBHOOK_SECRET=
